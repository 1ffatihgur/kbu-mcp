# docker compose için ayarlar — .env olarak kopyalayıp düzenleyin (.env depoya eklenmez)

# PostgreSQL parolası (değiştirin)
POSTGRES_PASSWORD=degistirin
# POSTGRES_PORT=5432
# MCP_PORT=7860

# Uzak MCP erişim anahtarları (virgülle ayrılmış). Boş bırakılırsa kimlik doğrulama KAPALI olur.
# İstemciler "Authorization: Bearer <anahtar>" başlığı veya ...?key=<anahtar> ile bağlanır.
KBU_API_KEYS=

# Embedding servisi (OpenAI uyumlu /v1/embeddings: Ollama, vLLM, TEI, üniversite LLM sunucusu...)
KBU_EMBED_URL=http://host.docker.internal:11434/v1
KBU_EMBED_MODEL=bge-m3
# KBU_EMBED_API_KEY=

# Tarama hız sınırı: tüm sitelere toplam saatlik istek (0 = sınırsız; yalnızca host başı gecikme)
KBU_CRAWL_MAX_PER_HOUR=3000
# KBÜ Medya haberleri için geriye dönük gün sınırı (2 yıl)
KBU_MEDYA_MAX_AGE_DAYS=730
# Bu boyuttan büyük dosyalar indirilmez (MB)
KBU_MAX_FILE_MB=300
